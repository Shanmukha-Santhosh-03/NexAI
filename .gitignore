dist/
**/dist/
build/
**/build/
coverage/
**/coverage/
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*


# Temporary files and caches
tmp/
**/tmp/
temp/
**/temp/
.cache/
**/.cache/


# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

